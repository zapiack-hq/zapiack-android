<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:id="@+id/zapiack_live_timer_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
        <Chronometer android:id="@+id/zapiack_live_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/zapiack_live_timer_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/zapiack_live_timer_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" android:visibility="gone" />
</LinearLayout>

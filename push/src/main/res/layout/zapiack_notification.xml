<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="4dp" android:paddingBottom="4dp">

    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <!-- The coloured box. -->
        <ImageView android:id="@+id/zapiack_bg" android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/zapiack_box" android:scaleType="fitXY" android:importantForAccessibility="no" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/zapiack_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/zapiack_body" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:maxLines="2" android:ellipsize="end" android:textSize="13sp" />
            </LinearLayout>
            <ImageView android:id="@+id/zapiack_thumb" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginStart="12dp" android:scaleType="centerCrop" android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- The shine: this flips between the band and nothing, and each time the band appears it sweeps across. -->
        <ViewFlipper android:id="@+id/zapiack_shine" android:layout_width="match_parent" android:layout_height="match_parent"
            android:autoStart="true" android:flipInterval="1400"
            android:inAnimation="@anim/zapiack_shine_in" android:outAnimation="@anim/zapiack_shine_out">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/zapiack_shine" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <!-- Empty, and a FrameLayout because a notification may only inflate the view types RemoteViews allows (a plain View is refused). -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" />
        </ViewFlipper>
    </FrameLayout>
</FrameLayout>

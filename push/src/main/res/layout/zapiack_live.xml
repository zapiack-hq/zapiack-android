<?xml version="1.0" encoding="utf-8"?>
<!--
  A template push with live parts: a countdown that ticks on its own, a progress bar with its steps, a counter and a badge.
  Only view types a notification may inflate are used (RemoteViews refuses the rest), and every part starts hidden: the code shows
  the ones the push carries.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="4dp" android:paddingBottom="4dp">

    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:id="@+id/zapiack_live_bg" android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/zapiack_box" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />

        <LinearLayout android:id="@+id/zapiack_live_content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/zapiack_live_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"
                    android:background="@drawable/zapiack_pill" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />

                <TextView android:id="@+id/zapiack_live_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
                <TextView android:id="@+id/zapiack_live_body" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:maxLines="2" android:ellipsize="end" android:textAppearance="@android:style/TextAppearance.Material.Notification" android:visibility="gone" />

                <!-- The countdown: a Chronometer when it ticks, plain text when it does not (or for days, which it cannot show). -->
                <LinearLayout android:id="@+id/zapiack_live_timer_row" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:orientation="horizontal" android:visibility="gone">
                    <Chronometer android:id="@+id/zapiack_live_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="26sp" android:textStyle="bold" android:paddingStart="0dp" android:paddingEnd="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/zapiack_live_timer_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="26sp" android:textStyle="bold" android:visibility="gone" />
                </LinearLayout>
                <TextView android:id="@+id/zapiack_live_timer_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="2" android:ellipsize="end" android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" android:visibility="gone" />

                <ProgressBar android:id="@+id/zapiack_live_progress" style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:visibility="gone" />
                <LinearLayout android:id="@+id/zapiack_live_steps" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:orientation="horizontal" android:visibility="gone">
                    <TextView android:id="@+id/zapiack_live_step0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/zapiack_live_step1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" />
                    <TextView android:id="@+id/zapiack_live_step2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" />
                    <TextView android:id="@+id/zapiack_live_step3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" />
                    <TextView android:id="@+id/zapiack_live_step4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:gravity="center" />
                    <TextView android:id="@+id/zapiack_live_step5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:gravity="end" />
                </LinearLayout>

                <TextView android:id="@+id/zapiack_live_counter" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textAppearance="@android:style/TextAppearance.Material.Notification" android:visibility="gone" />
            </LinearLayout>

            <ImageView android:id="@+id/zapiack_live_thumb" android:layout_width="52dp" android:layout_height="52dp"
                android:layout_marginStart="12dp" android:scaleType="centerCrop" android:importantForAccessibility="no" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
